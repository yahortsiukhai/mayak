# ============================================
# МАЯК — переменные окружения (ПРИМЕР)
# ============================================
# Этот файл — публичный ПРИМЕР.
# Реальные значения — в .env (не коммитится в Git).
#
# Скопируй его в .env:
#     cp .env.example .env
# ============================================

# --------------------------------------------
# Приложение
# --------------------------------------------
APP_NAME=Маяк
APP_ENV=development
DEBUG=true

# Секретный ключ для JWT (в проде — случайная строка 64+ символов)
SECRET_KEY=change-me-in-production-please

# --------------------------------------------
# База данных (PostgreSQL)
# --------------------------------------------
# ВАЖНО: +psycopg — для psycopg 3
DATABASE_URL=postgresql+psycopg://mayak:mayak@localhost:5432/mayak

# --------------------------------------------
# Redis
# --------------------------------------------
REDIS_URL=redis://localhost:6379/0

# --------------------------------------------
# Telegram (алерты)
# --------------------------------------------
# Токен бота — получим у @BotFather позже
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=

# --------------------------------------------
# Email
# --------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=